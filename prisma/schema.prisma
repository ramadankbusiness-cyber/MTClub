generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  LEADER
  MEMBER
}

enum Position {
  HEAD
  VICE
  LEADER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AttendanceRecordSource {
  UNKNOWN
  QR
  MANUAL
  EXCUSE
}

enum AttendanceAttemptStatus {
  REJECTED
  SUSPICIOUS
}

enum QrMode {
  ROTATING
  STATIC
}

enum AttendanceSessionOrigin {
  MANUAL
  EVENT
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PointTransactionType {
  EVENT_ATTENDANCE
  MANUAL_ADD
  MANUAL_DEDUCT
  ATTENDANCE_REVERSAL
  ATTENDANCE_ADJUSTMENT
}

enum NotificationType {
  ANNOUNCEMENT
  NEW_EVENT
  EVENT_REMINDER
  SESSION_OPENED
  ATTENDANCE_CONFIRMED
  ATTENDANCE_REJECTED
  ABSENCE_WARNING
  ACCOUNT_CREATED
  PASSWORD_CHANGED
  ROLE_CHANGED
  EXCUSE_DECISION
  POINTS_ADDED
  POINTS_DEDUCTED
  BIRTHDAY
}

enum NotificationAudience {
  EVERYONE
  ROLE
  COMMITTEE
  USERS
  MTC
  POSITION
}

enum FormAccessMode {
  MEMBERS_ONLY
  AUTHENTICATED_USERS
  PUBLIC
}

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum FormFieldType {
  SHORT_ANSWER
  PARAGRAPH
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  NUMBER
  DATE
  TIME
  EMAIL
  PHONE
  FILE_UPLOAD
}

enum FormDuplicatePolicy {
  ALLOW
  ONE_PER_USER
  ONE_PER_EMAIL
  ONE_PER_IP
}

enum FormSubmissionStatus {
  SUBMITTED
}

enum FormUploadStatus {
  PENDING
  ATTACHED
  EXPIRED
  DELETED
  DELETE_FAILED
}

enum FormEventKind {
  REGISTRATION
  FEEDBACK
  GENERAL
}

model Committee {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String   @unique
  nameAr        String
  type          String   @default("committee") @db.VarChar(20)
  descriptionEn String?  @db.VarChar(2000)
  descriptionAr String?  @db.VarChar(2000)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  users         User[]
  team          TeamMember[]
  events        Event[]
  sessions      AttendanceSession[]
  zones         Zone[]
  notifications Notification[]
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(MEMBER)
  position           Position @default(LEADER)
  isMTC              Boolean  @default(false)
  committeeId        String?
  phone              String?
  academicNumber     String?  @unique @db.VarChar(64)
  clubId             String?  @unique @db.VarChar(64)
  dateOfBirth        DateTime? @db.Date
  isActive           Boolean  @default(true)
  mustChangePassword        Boolean   @default(true)
  temporaryPasswordExpiresAt DateTime?
  sessionVersion            Int       @default(0)
  photoUrl           String?
  preferredLanguage  String   @default("en") @db.VarChar(2)
  googleSubject      String?  @unique @db.VarChar(255)
  googleEmail        String?  @db.VarChar(254)
  googleLinkedAt     DateTime?
  telegramUserId     String?  @unique @db.VarChar(32)
  telegramUsername   String?  @db.VarChar(64)
  telegramChatId     String?  @db.VarChar(32)
  telegramLinkedAt   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  committee          Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  teamEntries        TeamMember[]
  attendance         AttendanceRecord[]
  attempts           AttendanceAttempt[]
  excuses            Excuse[] @relation("ExcuseRequester")
  reviewedExcuses    Excuse[] @relation("ExcuseReviewer")
  authoredEvents     Event[] @relation("EventAuthor")
  authoredNotifications Notification[] @relation("NotificationAuthor")
  notificationRecipients NotificationRecipient[]
  pushSubscriptions  PushSubscription[]
  notificationPreferences NotificationPreference[]
  auditLogs          AuditLog[] @relation("AuditActor")
  passwordResetTokens PasswordResetToken[]
  pointTransactions  PointTransaction[] @relation("PointRecipient")
  actedPointTransactions PointTransaction[] @relation("PointActor")
  telegramLinkTokens TelegramLinkToken[]
  createdForms       Form[] @relation("FormCreator")
  updatedForms       Form[] @relation("FormUpdater")
  formSubmissions    FormSubmission[] @relation("FormSubmissions")
  formTemplatesCreated FormTemplate[] @relation("FormTemplatesCreated")
  formUploads        FormUpload[] @relation("FormUploadUploader")
  eventReadiness     EventReadiness[]
  birthdayDeliveries BirthdayDelivery[]
  certificatesReceived Certificate[] @relation("CertificateRecipient")
  certificatesIssued   Certificate[] @relation("CertificateIssuer")

  @@index([committeeId, role, isActive])
  @@index([isMTC, position])
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  title       String
  titleAr     String?
  position    Position  @default(LEADER)
  isMTC       Boolean   @default(false)
  committeeId String?
  bio         String?   @db.VarChar(500)
  bioAr       String?   @db.VarChar(500)
  socialLinks Json?
  photoUrl    String?
  order       Int       @default(0)
  visible     Boolean   @default(true)
  userId      String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visible, order])
  @@index([committeeId])
  @@index([isMTC, position])
}

model Zone {
  id          String   @id @default(cuid())
  name        String
  latitude    Float
  longitude   Float
  radiusMeters Int
  committeeId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  committee   Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  sessions    AttendanceSession[]
  eventZones  Event[]    @relation("EventZone")

  @@index([committeeId])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  titleAr         String?
  description     String   @db.VarChar(2000)
  descriptionAr   String?  @db.VarChar(2000)
  startsAt        DateTime
  endsAt          DateTime?
  location        String?
  placeName       String?
  centerLat       Float?
  centerLng       Float?
  radiusMeters    Int?
  locationAccuracy Float?
  zoneId          String?
  committeeId     String?
  createdById     String
  published       Boolean  @default(true)
  isOpen          Boolean  @default(true)
  qrAttendanceOpen Boolean @default(false)
  archivedAt      DateTime?
  attendancePoints Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  committee       Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  zone            Zone?      @relation("EventZone", fields: [zoneId], references: [id], onDelete: SetNull)
  createdBy       User     @relation("EventAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  attendanceSessions AttendanceSession[]
  pointTransactions  PointTransaction[]
  formEvents         FormEvent[]
  readiness          EventReadiness[]
  notifications      Notification[]

  @@index([published, startsAt])
  @@index([committeeId, startsAt])
  @@index([archivedAt, startsAt])
}

model AttendanceSession {
  id                String   @id @default(cuid())
  title             String
  eventId           String?
  committeeId       String?
  zoneId            String?
  placeName         String?
  centerLat         Float?
  centerLng         Float?
  radiusMeters      Int?
  locationAccuracy  Float?
  startsAt          DateTime
  endsAt            DateTime
  lateAfterMinutes  Int      @default(10)
  qrMode            QrMode   @default(ROTATING)
  qrEnabled         Boolean  @default(true)
  origin            AttendanceSessionOrigin @default(MANUAL)
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  event             Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  committee         Committee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  zone              Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  records           AttendanceRecord[]
  attempts          AttendanceAttempt[]
  qrTokens          QrToken[]
  excuses           Excuse[]

  @@index([startsAt, endsAt])
  @@index([committeeId, startsAt])
  @@index([eventId, startsAt])
  @@index([origin, eventId])
}

model AttendanceRecord {
  id             String                 @id @default(cuid())
  userId         String
  sessionId      String
  status         AttendanceStatus
  source         AttendanceRecordSource @default(UNKNOWN)
  checkedInAt    DateTime?
  distanceMeters Float?
  accuracyMeters Float?
  reason         String?                @db.VarChar(500)
  markedById     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  session        AttendanceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pointTransactions PointTransaction[]

  @@unique([userId, sessionId])
  @@index([sessionId, status])
  @@index([userId, checkedInAt])
  @@index([sessionId, source])
}

model AttendanceAttempt {
  id             String                  @id @default(cuid())
  userId         String?
  sessionId      String
  status         AttendanceAttemptStatus
  reason         String                  @db.VarChar(500)
  distanceMeters Float?
  accuracyMeters Float?
  deviceHash     String?
  ipHash         String?
  userAgent      String?                 @db.VarChar(500)
  createdAt      DateTime                @default(now())
  user           User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  session        AttendanceSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([deviceHash, createdAt])
}

model QrToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  sessionId String
  expiresAt DateTime
  static    Boolean  @default(false)
  createdAt DateTime @default(now())
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
}

model Excuse {
  id          String       @id @default(cuid())
  userId      String
  sessionId   String
  reason      String       @db.VarChar(1000)
  status      ExcuseStatus @default(PENDING)
  reviewerId  String?
  reviewedAt  DateTime?
  reviewNote  String?      @db.VarChar(500)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation("ExcuseRequester", fields: [userId], references: [id], onDelete: Cascade)
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewer    User?        @relation("ExcuseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([userId, sessionId])
  @@index([sessionId, status])
}

model PointTransaction {
  id                 String               @id @default(cuid())
  userId             String
  amount             Int
  reason             String               @db.VarChar(500)
  type               PointTransactionType
  eventId            String?
  attendanceRecordId String?
  actorId            String?
  dedupeKey          String?              @unique @db.VarChar(200)
  createdAt          DateTime             @default(now())
  user               User                 @relation("PointRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor              User?                @relation("PointActor", fields: [actorId], references: [id], onDelete: SetNull)
  event              Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  attendanceRecord   AttendanceRecord?    @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventId, createdAt])
  @@index([attendanceRecordId])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model Notification {
  id              String               @id @default(cuid())
  title           String
  titleAr         String?
  message         String   @db.VarChar(3000)
  messageAr       String?  @db.VarChar(3000)
  link            String?
  eventId         String?
  type            NotificationType
  audience        NotificationAudience
  audienceRole    Role?
  audiencePosition Position?
  committeeId     String?
  important       Boolean              @default(false)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdBy       User?                @relation("NotificationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  committee       Committee?           @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  event           Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  recipients      NotificationRecipient[]

  @@index([scheduledAt, sentAt])
  @@index([createdAt])
  @@index([eventId, type])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  deliveredAt    DateTime?
  pushSentAt     DateTime?
  pushAttempts   Int          @default(0)
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, createdAt])
  @@index([pushSentAt, pushAttempts])
}

model EventReadiness {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
  @@index([eventId, createdAt])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique @db.VarChar(2048)
  p256dh     String
  auth       String
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  inApp     Boolean          @default(true)
  push      Boolean          @default(true)
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}


model Certificate {
  id                      String   @id @default(cuid())
  certificateCode         String   @unique @db.VarChar(64)
  userId                  String
  issuedById              String?
  issuanceIdempotencyKey  String?  @db.VarChar(128)
  requestHash             String?  @db.VarChar(128)
  title                   String   @db.VarChar(200)
  titleAr                 String?  @db.VarChar(200)
  issuerName              String   @db.VarChar(200)
  issuerNameAr            String?  @db.VarChar(200)
  issueDate               DateTime @db.Date
  fileKey                 String   @db.VarChar(1024)
  fileName                String   @db.VarChar(255)
  fileMime                String   @db.VarChar(255)
  fileSize                Int
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation("CertificateRecipient", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy                User?    @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([issuedById, issuanceIdempotencyKey])
  @@index([userId, issueDate])
  @@index([issuedById, createdAt])
}
enum BirthdayDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model BirthdayDelivery {
  id             String                 @id @default(cuid())
  userId         String
  year           Int
  status         BirthdayDeliveryStatus @default(PENDING)
  notificationId String?
  claimedAt      DateTime               @default(now())
  sentAt         DateTime?
  lastError      String?                @db.VarChar(500)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([year, status])
  @@index([status, claimedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipHash     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipHash    String
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TelegramLinkToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(128)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Form {
  id              String              @id @default(cuid())
  publicSlug      String              @unique @db.VarChar(64)
  title           String              @db.VarChar(200)
  titleAr         String?             @db.VarChar(200)
  description     String?             @db.VarChar(5000)
  descriptionAr   String?             @db.VarChar(5000)
  accessMode      FormAccessMode      @default(MEMBERS_ONLY)
  status          FormStatus          @default(DRAFT)
  opensAt         DateTime?
  closesAt        DateTime?
  maxResponses    Int?
  duplicatePolicy FormDuplicatePolicy @default(ALLOW)
  publishedAt     DateTime?
  closedAt        DateTime?
  archivedAt      DateTime?
  createdById     String
  updatedById     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User                @relation("FormCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?               @relation("FormUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  fields          FormField[]
  submissions     FormSubmission[]
  eventLinks      FormEvent[]
  uploads         FormUpload[]

  @@index([createdById, updatedAt])
  @@index([status, updatedAt])
  @@index([accessMode, status])
}

model FormField {
  id            String        @id @default(cuid())
  formId        String
  type          FormFieldType
  label         String        @db.VarChar(300)
  labelAr       String?       @db.VarChar(300)
  description   String?       @db.VarChar(2000)
  descriptionAr String?       @db.VarChar(2000)
  required      Boolean       @default(false)
  order         Int           @default(0)
  options       Json?
  validation    Json?
  isArchived    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  form          Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers       FormAnswer[]
  uploads       FormUpload[]

  @@index([formId, order])
  @@index([formId, isArchived, order])
}

model FormEvent {
  id        String        @id @default(cuid())
  formId    String
  eventId   String
  kind      FormEventKind @default(GENERAL)
  createdAt DateTime      @default(now())
  form      Form          @relation(fields: [formId], references: [id], onDelete: Cascade)
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([formId, eventId])
  @@index([eventId, kind])
  @@index([formId])
}

model FormSubmission {
  id                String               @id @default(cuid())
  publicId          String               @unique @db.VarChar(64)
  formId            String
  respondentUserId  String?
  respondentEmail   String?              @db.VarChar(320)
  respondentName    String?              @db.VarChar(200)
  status            FormSubmissionStatus @default(SUBMITTED)
  ipHash            String?              @db.VarChar(128)
  userAgentHash     String?              @db.VarChar(128)
  submittedAt       DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  form              Form                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondentUser    User?                @relation("FormSubmissions", fields: [respondentUserId], references: [id], onDelete: SetNull)
  answers           FormAnswer[]
  uploads           FormUpload[]

  @@index([formId, submittedAt])
  @@index([respondentUserId, submittedAt])
  @@index([formId, respondentUserId])
  @@index([formId, respondentEmail])
  @@index([formId, ipHash])
}

model FormAnswer {
  id           String         @id @default(cuid())
  submissionId String
  fieldId      String
  value        Json?
  fileKey      String?        @db.VarChar(1024)
  fileName     String?        @db.VarChar(255)
  fileSize     Int?
  fileMime     String?        @db.VarChar(255)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        FormField      @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
  @@index([fieldId])
}

model FormUpload {
  id             String           @id @default(cuid())
  formId         String
  fieldId        String
  key            String           @unique @db.VarChar(1024)
  fileName       String           @db.VarChar(255)
  fileSize       Int
  fileMime       String           @db.VarChar(255)
  uploaderUserId String?
  ipHash         String?          @db.VarChar(128)
  tokenJti       String           @unique @db.VarChar(64)
  tokenExpiresAt DateTime
  status         FormUploadStatus @default(PENDING)
  submissionId   String?
  attachedAt     DateTime?
  deletedAt      DateTime?
  deleteAttempts Int              @default(0)
  lastDeleteError String?         @db.VarChar(500)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  form           Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  field          FormField        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  uploaderUser   User?            @relation("FormUploadUploader", fields: [uploaderUserId], references: [id], onDelete: SetNull)
  submission     FormSubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([formId, ipHash, createdAt])
  @@index([formId, uploaderUserId, createdAt])
  @@index([status, tokenExpiresAt])
  @@index([status, createdAt])
  @@index([submissionId])
  @@index([fieldId, createdAt])
}

model FormTemplate {
  id            String   @id @default(cuid())
  key           String?  @unique @db.VarChar(80)
  title         String   @db.VarChar(200)
  titleAr       String?  @db.VarChar(200)
  description   String?  @db.VarChar(2000)
  descriptionAr String?  @db.VarChar(2000)
  category      String   @db.VarChar(80)
  isSystem      Boolean  @default(false)
  fields        Json
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     User?    @relation("FormTemplatesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category, updatedAt])
}
